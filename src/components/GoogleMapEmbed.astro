---
interface Props {
  address?: string;
  zoom?: number;
}

const { 
  address = "Plot 45, Industrial Area, Kampala, Uganda",
  zoom = 15
} = Astro.props;

const googleMapsSearchUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(address)}`;
---

<div class="space-y-3">
  <div class="flex items-center justify-between">
    <div>
      <span class="text-[11px] font-bold tracking-widest uppercase text-stone-500">FIND US (DEMO LOCATION)</span>
      <h4 class="text-sm font-bold text-stone-900">Demo Coffee Exporters Ltd.</h4>
    </div>
    <a
      href={googleMapsSearchUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center space-x-1.5 text-xs font-bold text-coffee-600 hover:text-coffee-700 tracking-wider uppercase transition-colors"
    >
      <span>OPEN IN GOOGLE MAPS</span>
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
      </svg>
    </a>
  </div>

  <div class="w-full h-72 sm:h-80 rounded-xl overflow-hidden border border-stone-200 shadow-sm relative bg-stone-100">
    <iframe
      title="Demo Coffee Exporters Location Map"
      width="100%"
      height="100%"
      style="border:0;"
      loading="lazy"
      allowfullscreen=""
      referrerpolicy="no-referrer-when-downgrade"
      src="https://maps.google.com/maps?q=Plot+45+Industrial+Area+Kampala+Uganda&t=&z=15&ie=UTF8&iwloc=&output=embed"
    ></iframe>
  </div>
</div>

