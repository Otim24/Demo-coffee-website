---
interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

const navLinks = [
  { key: 'nav_home', name: 'HOME', href: '/' },
  { key: 'nav_about', name: 'ABOUT US', href: '/about' },
  { key: 'nav_coffee', name: 'OUR COFFEE', href: '/coffee' },
  { key: 'nav_export', name: 'EXPORT SERVICES', href: '/export-services' },
  { key: 'nav_sustainability', name: 'SUSTAINABILITY', href: '/sustainability' },
  { key: 'nav_quality', name: 'QUALITY', href: '/quality' },
  { key: 'nav_buyers', name: 'FOR BUYERS', href: '/for-buyers' },
  { key: 'nav_blog', name: 'BLOG', href: '/blog' },
];

const isActive = (href: string) => {
  if (href === '/' && currentPath === '/') return true;
  if (href !== '/' && currentPath.startsWith(href)) return true;
  return false;
};
---

<header class="sticky top-0 z-50 w-full transition-all duration-300">
  <!-- Clean Utility Top Bar (Without AI Slop Disclaimers) -->
  <div class="bg-[#171513] text-stone-300 text-[11px] tracking-wider border-b border-stone-800/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-2.5 flex flex-wrap items-center justify-between gap-3">
      <!-- Direct Contact Numbers -->
      <div class="flex items-center space-x-6">
        <a 
          href="tel:+256754849895" 
          class="flex items-center space-x-2 text-stone-300 hover:text-white transition-colors duration-200"
          title="Direct Trade Desk"
        >
          <svg class="w-3.5 h-3.5 text-coffee-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          <span class="font-medium">+256754849895</span>
        </a>
        
        <a 
          href="mailto:trade@democoffeeexporters.com" 
          class="hidden sm:flex items-center space-x-2 text-stone-300 hover:text-white transition-colors duration-200 uppercase"
          title="Export Inquiries"
        >
          <svg class="w-3.5 h-3.5 text-coffee-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
          </svg>
          <span class="font-medium tracking-wider">trade@democoffeeexporters.com</span>
        </a>
      </div>

      <!-- Regulatory Badge & Functional Language Selector -->
      <div class="flex items-center space-x-5 ml-auto">
        <div class="hidden lg:flex items-center space-x-2 text-[11px] text-stone-400 font-medium">
          <span class="inline-block w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
          <span data-i18n="top_ucda">REGISTERED WITH UGANDA COFFEE DEVELOPMENT AUTHORITY (UCDA)</span>
        </div>

        <!-- Fully Interactive Language Selector -->
        <div class="relative" id="language-switcher-container">
          <button 
            type="button" 
            id="lang-menu-button"
            class="flex items-center space-x-2 py-1 px-3 rounded-full bg-stone-900 border border-stone-700/80 text-stone-200 text-[11px] font-semibold hover:border-coffee-500 transition-all focus:outline-none focus:ring-1 focus:ring-coffee-500"
            aria-expanded="false"
            aria-haspopup="true"
          >
            <svg class="w-3.5 h-3.5 text-coffee-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/>
            </svg>
            <span id="current-lang-code" class="font-bold tracking-wider">EN</span>
            <svg class="w-2.5 h-2.5 text-stone-400 transition-transform duration-200" id="lang-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>
          
          <!-- Dropdown Menu -->
          <div 
            id="lang-dropdown-menu"
            class="hidden absolute right-0 mt-2 w-44 bg-stone-900/95 backdrop-blur-xl border border-stone-700 rounded-2xl shadow-2xl py-2 text-xs text-stone-300 z-50 divide-y divide-stone-800"
          >
            <div class="py-1">
              <button 
                type="button" 
                data-lang="en" 
                class="lang-option w-full text-left px-4 py-2 hover:bg-white/10 hover:text-white flex items-center justify-between transition-colors font-medium"
              >
                <span>English (EN)</span>
                <span class="active-check text-coffee-400 font-bold">✓</span>
              </button>
              <button 
                type="button" 
                data-lang="fr" 
                class="lang-option w-full text-left px-4 py-2 hover:bg-white/10 hover:text-white flex items-center justify-between transition-colors font-medium"
              >
                <span>Francais (FR)</span>
                <span class="active-check text-coffee-400 font-bold hidden">✓</span>
              </button>
              <button 
                type="button" 
                data-lang="de" 
                class="lang-option w-full text-left px-4 py-2 hover:bg-white/10 hover:text-white flex items-center justify-between transition-colors font-medium"
              >
                <span>Deutsch (DE)</span>
                <span class="active-check text-coffee-400 font-bold hidden">✓</span>
              </button>
              <button 
                type="button" 
                data-lang="nl" 
                class="lang-option w-full text-left px-4 py-2 hover:bg-white/10 hover:text-white flex items-center justify-between transition-colors font-medium"
              >
                <span>Nederlands (NL)</span>
                <span class="active-check text-coffee-400 font-bold hidden">✓</span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Floating Glass Navigation Area -->
  <div class="bg-gradient-to-b from-stone-950/70 via-stone-900/50 to-transparent backdrop-blur-md pt-3 pb-3">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between gap-4">
        
        <!-- Brand Logo -->
        <a href="/" class="flex items-center space-x-3 group flex-shrink-0" aria-label="Demo Coffee Exporters Home">
          <!-- Glass Logo Icon Badge -->
          <div class="w-11 h-11 md:w-12 md:h-12 rounded-full flex-shrink-0 flex items-center justify-center bg-white/10 backdrop-blur-md border border-white/20 shadow-md group-hover:border-coffee-400 transition-all duration-300">
            <svg viewBox="0 0 100 100" class="w-7 h-7 md:w-8 md:h-8 text-coffee-300" fill="currentColor">
              <path d="M50 88 C48 70 42 45 35 20 C34 18 36 17 37 19 C45 42 52 68 52 88 Z" fill="#D5C3B3"/>
              <path d="M43 45 C30 42 20 48 18 58 C26 62 38 56 43 45 Z" fill="#6C8B64"/>
              <path d="M48 35 C58 28 70 30 76 38 C70 46 56 44 48 35 Z" fill="#6C8B64"/>
              <circle cx="48" cy="50" r="7.5" fill="#E79A6D"/>
              <circle cx="58" cy="48" r="7" fill="#A35326"/>
              <circle cx="52" cy="62" r="7" fill="#713214"/>
            </svg>
          </div>
          
          <!-- Typography -->
          <div class="flex flex-col">
            <span class="text-[11px] md:text-xs font-extrabold tracking-[0.24em] text-coffee-300 uppercase leading-none">
              DEMO COFFEE
            </span>
            <span class="text-base md:text-lg font-bold tracking-tight text-white font-serif leading-tight">
              Exporters Ltd.
            </span>
          </div>
        </a>

        <!-- Desktop Pill-Shaped Glass Navigation Container (HOME to GET QUOTE) -->
        <nav class="hidden xl:flex items-center rounded-full bg-stone-900/80 backdrop-blur-xl border border-white/15 shadow-2xl p-1.5 pl-6 pr-1.5 space-x-1">
          {navLinks.map((link) => (
            <a
              href={link.href}
              data-i18n={link.key}
              class={`text-[11px] tracking-[0.14em] font-bold uppercase transition-all duration-200 px-3.5 py-2 rounded-full ${
                isActive(link.href)
                  ? 'bg-white/15 text-white shadow-inner font-extrabold border border-white/20'
                  : 'text-stone-300 hover:text-white hover:bg-white/10'
              }`}
            >
              {link.name}
            </a>
          ))}

          <!-- Pill-Enclosed GET QUOTE Action Button -->
          <a
            href="/quote"
            data-i18n="nav_quote"
            class="inline-flex items-center justify-center px-5 py-2.5 rounded-full text-[11px] font-bold tracking-widest uppercase text-white bg-gradient-to-r from-[#A35326] to-[#C16230] hover:from-[#8E431B] hover:to-[#A35326] transition-all duration-200 shadow-md hover:shadow-lg active:scale-95 ml-2 border border-amber-500/30 whitespace-nowrap"
          >
            GET QUOTE
          </a>
        </nav>

        <!-- Mobile & Tablet Glass Menu Trigger & Quick Quote Pill -->
        <div class="flex xl:hidden items-center space-x-2">
          <div class="rounded-full bg-stone-900/80 backdrop-blur-md border border-white/15 p-1 flex items-center space-x-2">
            <a
              href="/quote"
              data-i18n="nav_quote"
              class="inline-flex items-center px-3.5 py-1.5 rounded-full text-[11px] font-bold tracking-wider uppercase text-white bg-[#A35326] hover:bg-[#8E431B]"
            >
              QUOTE
            </a>
            <button
              type="button"
              id="mobile-menu-open-btn"
              class="p-2 rounded-full text-stone-300 hover:text-white hover:bg-white/10 focus:outline-none"
              aria-label="Open mobile navigation menu"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
              </svg>
            </button>
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- Mobile Drawer Backdrop & Glass Panel -->
  <div 
    id="mobile-drawer" 
    class="fixed inset-0 z-50 bg-stone-950/70 backdrop-blur-sm transition-opacity duration-300 opacity-0 pointer-events-none xl:hidden"
    aria-hidden="true"
  >
    <div 
      id="mobile-drawer-content"
      class="fixed inset-y-0 right-0 max-w-xs w-full bg-stone-900/95 backdrop-blur-2xl border-l border-white/10 text-white shadow-2xl flex flex-col transform translate-x-full transition-transform duration-300 ease-in-out p-6"
    >
      <!-- Drawer Header -->
      <div class="flex items-center justify-between pb-5 border-b border-stone-800">
        <div class="flex flex-col">
          <span class="text-[11px] font-bold tracking-[0.2em] text-coffee-400 uppercase">
            DEMO COFFEE
          </span>
          <span class="text-base font-bold text-white font-serif">
            Exporters Ltd.
          </span>
        </div>
        <button 
          id="mobile-menu-close-btn"
          type="button" 
          class="p-2 rounded-full text-stone-400 hover:text-white hover:bg-stone-800"
          aria-label="Close mobile navigation menu"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>

      <!-- Drawer Nav Links -->
      <nav class="flex-1 py-6 overflow-y-auto space-y-1.5">
        {navLinks.map((link) => (
          <a
            href={link.href}
            data-i18n={link.key}
            class={`block px-4 py-2.5 rounded-full text-xs font-semibold tracking-wider transition-all ${
              isActive(link.href)
                ? 'bg-[#A35326] text-white font-bold shadow'
                : 'text-stone-300 hover:bg-white/10 hover:text-white'
            }`}
          >
            {link.name}
          </a>
        ))}
      </nav>

      <!-- Drawer Footer -->
      <div class="pt-4 border-t border-stone-800 space-y-3">
        <a
          href="/quote"
          data-i18n="nav_quote_full"
          class="block w-full py-3 px-4 rounded-full text-center text-xs font-bold tracking-widest uppercase text-white bg-[#A35326] hover:bg-[#8E431B] shadow-lg"
        >
          GET AN EXPORT QUOTE
        </a>
        <div class="text-[11px] text-stone-400 text-center leading-relaxed">
          Plot 45, Industrial Area, Kampala, Uganda<br/>
          Direct Export Inquiries Desk
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  import { setupI18n } from '../scripts/i18n-engine';

  function setupMobileMenu() {
    const openBtn = document.getElementById('mobile-menu-open-btn');
    const closeBtn = document.getElementById('mobile-menu-close-btn');
    const drawer = document.getElementById('mobile-drawer');
    const drawerContent = document.getElementById('mobile-drawer-content');

    if (!openBtn || !closeBtn || !drawer || !drawerContent) return;

    function openDrawer() {
      drawer!.classList.remove('opacity-0', 'pointer-events-none');
      drawer!.classList.add('opacity-100', 'pointer-events-auto');
      drawerContent!.classList.remove('translate-x-full');
      drawerContent!.classList.add('translate-x-0');
      document.body.style.overflow = 'hidden';
    }

    function closeDrawer() {
      drawer!.classList.remove('opacity-100', 'pointer-events-auto');
      drawer!.classList.add('opacity-0', 'pointer-events-none');
      drawerContent!.classList.remove('translate-x-0');
      drawerContent!.classList.add('translate-x-full');
      document.body.style.overflow = '';
    }

    openBtn.addEventListener('click', openDrawer);
    closeBtn.addEventListener('click', closeDrawer);
    drawer.addEventListener('click', function(e: Event) {
      if (e.target === drawer) closeDrawer();
    });
  }

  function initHeader() {
    setupI18n();
    setupMobileMenu();
  }

  initHeader();
  document.addEventListener('astro:page-load', initHeader);
</script>
