---
const currentYear = new Date().getFullYear();
---

<footer class="bg-[#121110] text-stone-300 border-t border-stone-800">
  <!-- Top Demonstration & Accreditation Notice Banner -->
  <div class="border-b border-stone-800/80 bg-stone-950 py-4">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row items-center justify-between gap-3 text-xs">
      <div class="flex items-center space-x-3 text-amber-300/90 font-medium">
        <span class="inline-flex items-center justify-center px-2 py-0.5 rounded-full bg-amber-950/80 border border-amber-600/50 text-amber-300 font-bold text-[10px]">
          DEMO PLATFORM
        </span>
        <span class="tracking-wide">
          Demonstration Website Prototype: All trade figures, addresses, and specifications are simulated for presentation purposes.
        </span>
      </div>
      <div class="flex items-center space-x-5 text-stone-400 text-[11px]">
        <span>FOB Mombasa Port Terms</span>
        <span class="text-stone-700">|</span>
        <span>EUDR Geo-Traceability Simulation</span>
        <span class="text-stone-700">|</span>
        <span>SCA Cupping Protocols</span>
      </div>
    </div>
  </div>

  <!-- Main Footer Content -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-20">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 lg:gap-8">
      
      <!-- Brand & Mission Column -->
      <div class="lg:col-span-2 space-y-6">
        <div class="flex items-center space-x-3.5">
          <div class="w-11 h-11 flex-shrink-0 flex items-center justify-center bg-stone-800/90 rounded-full border border-stone-700">
            <svg viewBox="0 0 100 100" class="w-7 h-7" fill="currentColor">
              <path d="M50 88 C48 70 42 45 35 20 C34 18 36 17 37 19 C45 42 52 68 52 88 Z" fill="#BF9473"/>
              <path d="M43 45 C30 42 20 48 18 58 C26 62 38 56 43 45 Z" fill="#4B6347"/>
              <path d="M48 35 C58 28 70 30 76 38 C70 46 56 44 48 35 Z" fill="#4B6347"/>
              <circle cx="48" cy="50" r="7" fill="#A35326"/>
              <circle cx="58" cy="48" r="6.5" fill="#8E3F18"/>
            </svg>
          </div>
          <div>
            <div class="text-xs font-bold tracking-[0.24em] text-coffee-400 uppercase">DEMO COFFEE</div>
            <div class="text-lg font-bold text-white font-serif tracking-tight">Exporters Ltd.</div>
          </div>
        </div>

        <p data-i18n="footer_desc" class="text-sm text-stone-400 leading-relaxed max-w-sm">
          A prototype export portal showcasing simulated origin-verified specialty Arabica and Screen 18 fine Robusta coffees from Ugandan highlands. Demonstrating dry milling capabilities, cupping laboratory workflows, and international shipping logistics.
        </p>

        <div class="space-y-2 text-xs text-stone-300">
          <div class="flex items-start space-x-3">
            <svg class="w-4 h-4 text-coffee-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            <span data-i18n="direct_office_addr">Plot 45, Industrial Area, Kampala, Uganda (Simulated Office)</span>
          </div>
          <div class="flex items-center space-x-3">
            <svg class="w-4 h-4 text-coffee-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            <span>+256754849895</span>
          </div>
          <div class="flex items-center space-x-3">
            <svg class="w-4 h-4 text-coffee-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            <span class="break-all">trade@democoffeeexporters.com</span>
          </div>
        </div>
      </div>

      <!-- Column 2: Coffee Origins & Grades -->
      <div class="space-y-4">
        <h3 data-i18n="footer_col_varieties" class="text-xs font-bold uppercase tracking-widest text-white border-l-2 border-coffee-500 pl-2.5">
          Export Varieties
        </h3>
        <ul class="space-y-2 text-sm text-stone-400">
          <li><a href="/coffee#bugisu-aa" class="hover:text-coffee-300 transition-colors">Bugisu Arabica AA</a></li>
          <li><a href="/coffee#bugisu-a" class="hover:text-coffee-300 transition-colors">Bugisu Arabica A</a></li>
          <li><a href="/coffee#peaberry" class="hover:text-coffee-300 transition-colors">Bugisu Peaberry (PB)</a></li>
          <li><a href="/coffee#rwenzori" class="hover:text-coffee-300 transition-colors">Rwenzori Natural Specialty</a></li>
          <li><a href="/coffee#robusta-18" class="hover:text-coffee-300 transition-colors">Uganda Robusta Screen 18</a></li>
          <li><a href="/coffee#robusta-15" class="hover:text-coffee-300 transition-colors">Uganda Robusta Screen 15</a></li>
          <li><a href="/coffee#organic" class="hover:text-coffee-300 transition-colors">Certified Organic Origins</a></li>
        </ul>
      </div>

      <!-- Column 3: Corporate & Trade -->
      <div class="space-y-4">
        <h3 data-i18n="footer_col_nav" class="text-xs font-bold uppercase tracking-widest text-white border-l-2 border-coffee-500 pl-2.5">
          Portal Navigation
        </h3>
        <ul class="space-y-2 text-sm text-stone-400">
          <li><a href="/about" data-i18n="nav_about" class="hover:text-coffee-300 transition-colors">About Us</a></li>
          <li><a href="/export-services" data-i18n="nav_export" class="hover:text-coffee-300 transition-colors">Export Services</a></li>
          <li><a href="/quality" data-i18n="nav_quality" class="hover:text-coffee-300 transition-colors">Quality</a></li>
          <li><a href="/sustainability" data-i18n="nav_sustainability" class="hover:text-coffee-300 transition-colors">Sustainability</a></li>
          <li><a href="/for-buyers" data-i18n="nav_buyers" class="hover:text-coffee-300 transition-colors">For Buyers</a></li>
          <li><a href="/blog" data-i18n="nav_blog" class="hover:text-coffee-300 transition-colors">Blog</a></li>
          <li><a href="/quote" data-i18n="nav_quote_full" class="text-coffee-400 font-semibold hover:text-white transition-colors">Get an Export Quote</a></li>
        </ul>
      </div>

      <!-- Column 4: Shipping & Sample Notice -->
      <div class="space-y-4">
        <h3 data-i18n="footer_col_sample" class="text-xs font-bold uppercase tracking-widest text-white border-l-2 border-coffee-500 pl-2.5">
          Sample Request Desk
        </h3>
        <p data-i18n="footer_sample_desc" class="text-xs text-stone-400 leading-relaxed">
          Pre-shipment green coffee sample simulations (300g to 500g) can be tested using the interactive quote form.
        </p>
        <div class="pt-2">
          <a
            href="/quote"
            data-i18n="footer_btn_test"
            class="inline-block w-full text-center py-2.5 px-4 rounded-full bg-stone-800 hover:bg-coffee-600 text-white text-xs font-bold uppercase tracking-wider transition-colors duration-200 border border-stone-700"
          >
            Submit Sample Request
          </a>
        </div>
        <div data-i18n="footer_hours" class="pt-2 text-[11px] text-stone-500 leading-relaxed">
          Trade Desk Hours: Mon to Fri, 08:00 to 17:00 East Africa Time (EAT).
        </div>
      </div>

    </div>
  </div>

  <!-- Bottom Legal Strip -->
  <div class="border-t border-stone-800/80 bg-stone-950 py-6 text-xs text-stone-500">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row items-center justify-between gap-4">
      <div data-i18n="footer_rights">
        Demo Coffee Exporters Ltd. All rights reserved.
      </div>
      <div class="flex items-center space-x-6 text-[11px]">
        <span data-i18n="footer_terms">Simulated Incoterms: FOB Mombasa / CIF Direct Ocean Delivery.</span>
      </div>
    </div>
  </div>
</footer>
