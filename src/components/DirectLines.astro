---
import GoogleMapEmbed from './GoogleMapEmbed.astro';
---

<div class="space-y-8">
  <div>
    <h2 data-i18n="direct_title" class="text-3xl sm:text-4xl font-bold font-serif text-stone-900 tracking-tight mb-2">
      Direct Lines
    </h2>
    <p data-i18n="direct_desc" class="text-stone-600 text-sm">
      Connect with our export logistics desk, quality laboratory, and sample desk in Kampala.
    </p>
  </div>

  <!-- Cards matching screenshot style -->
  <div class="space-y-6">
    
    <!-- Item 1: Head Office & Processing -->
    <div class="flex items-start space-x-4">
      <div class="w-12 h-12 rounded-2xl bg-[#FAF2EB] border border-[#EBD6C3] flex items-center justify-center flex-shrink-0 text-[#A35326] shadow-sm">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
        </svg>
      </div>
      <div>
        <span data-i18n="direct_office_tag" class="block text-[11px] font-bold tracking-widest uppercase text-stone-500 mb-1">
          HEAD OFFICE & PROCESSING
        </span>
        <div data-i18n="direct_office_addr" class="text-base font-semibold text-stone-900">
          Plot 45, Industrial Area
        </div>
        <div data-i18n="direct_office_city" class="text-sm text-stone-600">
          Kampala, Uganda
        </div>
      </div>
    </div>

    <!-- Item 2: Email Inquiries -->
    <div class="flex items-start space-x-4">
      <div class="w-12 h-12 rounded-2xl bg-[#FAF2EB] border border-[#EBD6C3] flex items-center justify-center flex-shrink-0 text-[#A35326] shadow-sm">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
        </svg>
      </div>
      <div>
        <span data-i18n="direct_email_tag" class="block text-[11px] font-bold tracking-widest uppercase text-stone-500 mb-1">
          EMAIL INQUIRIES
        </span>
        <a 
          href="mailto:trade@democoffeeexporters.com" 
          class="text-base font-semibold text-stone-900 hover:text-coffee-600 transition-colors break-all"
        >
          trade@democoffeeexporters.com
        </a>
        <div data-i18n="direct_email_sub" class="text-xs text-stone-500 mt-0.5">
          We aim to respond within 24 hours.
        </div>
      </div>
    </div>

    <!-- Item 3: Phone / WhatsApp -->
    <div class="flex items-start space-x-4">
      <div class="w-12 h-12 rounded-2xl bg-[#FAF2EB] border border-[#EBD6C3] flex items-center justify-center flex-shrink-0 text-[#A35326] shadow-sm">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
        </svg>
      </div>
      <div>
        <span data-i18n="direct_phone_tag" class="block text-[11px] font-bold tracking-widest uppercase text-stone-500 mb-1">
          PHONE / WHATSAPP
        </span>
        <a 
          href="tel:+256754849895" 
          class="text-base font-semibold text-stone-900 hover:text-coffee-600 transition-colors"
        >
          +256754849895
        </a>
        <div data-i18n="direct_phone_sub" class="text-xs text-stone-500 mt-0.5">
          Available Mon-Fri, 08:00 - 17:00 EAT
        </div>
      </div>
    </div>

  </div>

  <!-- Google Map Embed Section -->
  <div class="pt-4 border-t border-stone-200">
    <GoogleMapEmbed address="Plot 45, Industrial Area, Kampala, Uganda" />
  </div>
</div>
