<script>
  import { typewriterPhrases } from '../scripts/translations';
  import { getPreferredLanguage } from '../scripts/i18n-engine';

  // Dynamic Typewriter Animation Engine with Multilingual Support
  function setupTypewriter() {
    const target = document.getElementById('hero-typewriter-text');
    if (!target) return;

    let currentLang = getPreferredLanguage();
    let phrases = typewriterPhrases[currentLang] || typewriterPhrases.en;

    let phraseIndex = 0;
    let charIndex = 0;
    let isDeleting = false;
    let timeoutId: number;

    function type() {
      const currentPhrase = phrases[phraseIndex] || phrases[0];

      if (isDeleting) {
        target!.textContent = currentPhrase.substring(0, charIndex - 1);
        charIndex--;
      } else {
        target!.textContent = currentPhrase.substring(0, charIndex + 1);
        charIndex++;
      }

      let speed = isDeleting ? 25 : 55;

      if (!isDeleting && charIndex === currentPhrase.length) {
        speed = 2200; // Pause after typing full phrase
        isDeleting = true;
      } else if (isDeleting && charIndex === 0) {
        isDeleting = false;
        phraseIndex = (phraseIndex + 1) % phrases.length;
        speed = 400; // Pause before typing next phrase
      }

      timeoutId = window.setTimeout(type, speed);
    }

    type();

    // Listen for language changes and adapt phrases seamlessly
    window.addEventListener('demo:languagechange', ((e: CustomEvent) => {
      const newLang = e.detail?.lang || 'en';
      phrases = typewriterPhrases[newLang] || typewriterPhrases.en;
      phraseIndex = 0;
      charIndex = 0;
      isDeleting = false;
    }) as EventListener);

    // Clean up if page is navigated away with View Transitions
    document.addEventListener('astro:before-swap', () => {
      window.clearTimeout(timeoutId);
    }, { once: true });
  }

  setupTypewriter();
  document.addEventListener('astro:page-load', setupTypewriter);
</script>
